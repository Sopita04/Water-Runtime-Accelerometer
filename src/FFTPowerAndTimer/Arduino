#include <SPI.h>
#include <arduinoFFT.h>
#include <math.h>

// =============================
// SAMPLING SETTINGS
// =============================

const uint16_t N = 256;
const double Fs = 2000.0;
const uint32_t samplePeriod = 500;

// Frequency range to investigate
const double BAND_LOW = 0;
const double BAND_HIGH = 50.0;

// EXAMPLE THRESHOLDS - MUST BE CALIBRATED
// Units: g^2 (mean-square vibration acceleration)
const double FLOW_ON_THRESHOLD = 0.00010;
const double FLOW_OFF_THRESHOLD = 0.00007;

// =============================
// FFT ARRAYS
// =============================

double vReal[N];
double vImag[N];

ArduinoFFT<double> FFT(vReal, vImag, N, Fs);

// Store samples for all 3 axes
float xSamples[N];
float ySamples[N];
float zSamples[N];

// Mean-square correction for Hamming window
double windowPowerCorrection = 1.0;

// =============================
// ESP32 SPI PINS
// =============================

const int CS_PIN = 33;
const int SCK_PIN = 5;
const int MOSI_PIN = 19;
const int MISO_PIN = 21;

// =============================
// IIS3DWB REGISTERS
// =============================

const byte WHO_AM_I = 0x0F;
const byte CTRL1_XL = 0x10;
const byte CTRL3_C = 0x12;
const byte OUTX_L_A = 0x28;

SPISettings accelSPI(1000000, MSBFIRST, SPI_MODE0);

// =============================
// WRITE REGISTER
// =============================

void writeRegister(byte reg, byte value)
{
  SPI.beginTransaction(accelSPI);
  digitalWrite(CS_PIN, LOW);

  SPI.transfer(reg & 0x7F);
  SPI.transfer(value);

  digitalWrite(CS_PIN, HIGH);
  SPI.endTransaction();
}

// =============================
// READ REGISTER
// =============================

byte readRegister(byte reg)
{
  SPI.beginTransaction(accelSPI);
  digitalWrite(CS_PIN, LOW);

  SPI.transfer(reg | 0x80);
  byte value = SPI.transfer(0x00);

  digitalWrite(CS_PIN, HIGH);
  SPI.endTransaction();

  return value;
}

// =============================
// READ X Y Z
// =============================

void readAcceleration(float &x, float &y, float &z)
{
  byte data[6];

  SPI.beginTransaction(accelSPI);
  digitalWrite(CS_PIN, LOW);

  SPI.transfer(OUTX_L_A | 0x80);

  for (int i = 0; i < 6; i++)
  {
    data[i] = SPI.transfer(0x00);
  }

  digitalWrite(CS_PIN, HIGH);
  SPI.endTransaction();

  int16_t rawX = (int16_t)((data[1] << 8) | data[0]);
  int16_t rawY = (int16_t)((data[3] << 8) | data[2]);
  int16_t rawZ = (int16_t)((data[5] << 8) | data[4]);

  const float sensitivity = 0.000061;

  x = rawX * sensitivity;
  y = rawY * sensitivity;
  z = rawZ * sensitivity;
}

// =============================
// CALCULATE HAMMING CORRECTION
// =============================

void calculateWindowCorrection()
{
  double sum = 0;

  for (int i = 0; i < N; i++)
  {
    double w = 0.54 - 0.46 *
      cos(2.0 * PI * i / (N - 1));

    sum += w * w;
  }

  windowPowerCorrection = sum / N;
}

// =============================
// CALCULATE FREQUENCY-BAND POWER
// =============================

double calculateBandPower(const float samples[],
                          double *peakHz = nullptr)
{
  // STEP 1: Load accelerometer samples
  for (int i = 0; i < N; i++)
  {
    vReal[i] = samples[i];
    vImag[i] = 0.0;
  }

  // STEP 2: Remove DC
  FFT.dcRemoval();

  // STEP 3: Apply Hamming window
  FFT.windowing(
    FFTWindow::Hamming,
    FFTDirection::Forward
  );

  // STEP 4: Compute FFT
  FFT.compute(FFTDirection::Forward);

  // STEP 5: Sum squared FFT magnitudes
  // inside selected frequency band

  double bandSum = 0;
  double maxMagnitudeSquared = 0;
  int peakBin = 0;

  for (int i = 1; i < N / 2; i++)
  {
    double frequency = i * Fs / N;

    double magnitudeSquared =
      vReal[i] * vReal[i] +
      vImag[i] * vImag[i];

    if (magnitudeSquared > maxMagnitudeSquared)
    {
      maxMagnitudeSquared = magnitudeSquared;
      peakBin = i;
    }

    if (frequency >= BAND_LOW &&
        frequency <= BAND_HIGH)
    {
      bandSum += magnitudeSquared;
    }
  }

  if (peakHz != nullptr)
  {
    *peakHz = peakBin * Fs / N;
  }

  // STEP 6: Normalize to mean-square acceleration
  // Factor 2 accounts for negative frequencies
  // Window correction compensates Hamming power loss

  double bandPower =
    (2.0 * bandSum) /
    ((double)N * N * windowPowerCorrection);

  return bandPower;
}

// =============================
// SETUP
// =============================

void setup()
{
  Serial.begin(115200);
  delay(1000);

  SPI.begin(SCK_PIN, MISO_PIN, MOSI_PIN, CS_PIN);

  pinMode(CS_PIN, OUTPUT);
  digitalWrite(CS_PIN, HIGH);

  delay(100);

  byte id = readRegister(WHO_AM_I);

  Serial.print("WHO_AM_I = 0x");
  Serial.println(id, HEX);

  if (id != 0x7B)
  {
    Serial.println("ERROR: IIS3DWB not detected!");

    while (1)
    {
      delay(1000);
    }
  }

  Serial.println("IIS3DWB detected!");

  // Block data update and register increment
  writeRegister(CTRL3_C, 0x44);

  // LPF2 settings
  writeRegister(0x17, 0x60);

  // Enable 3-axis accelerometer
  // +/-2g and LPF2
  writeRegister(CTRL1_XL, 0xA2);

  calculateWindowCorrection();

  delay(200);
}

// =============================
// MAIN LOOP
// =============================

void loop()
{
  static bool flowDetected = false;

  // =============================
  // TIMER SETTINGS
  // =============================

  const unsigned long FLOW_ON_DELAY = 2000;  // 2 seconds
  const unsigned long FLOW_OFF_DELAY = 3000; // 3 seconds

  static unsigned long transitionStart = 0;
  static bool transitionPending = false;

  // Track time spent in current state
  static unsigned long stateStart = millis();

  // Save durations of previous states
  static unsigned long lastOnDuration = 0;
  static unsigned long lastOffDuration = 0;

  // =============================
  // RMS ACCUMULATORS
  // =============================

  double sumX = 0, sumY = 0, sumZ = 0;
  double sumX2 = 0, sumY2 = 0, sumZ2 = 0;

  uint32_t nextSampleTime = micros();

  // STEP 1: Collect 256 samples
  for (int i = 0; i < N; i++)
  {
    while ((int32_t)(micros() - nextSampleTime) < 0)
    {
    }

    float x, y, z;
    readAcceleration(x, y, z);

    xSamples[i] = x;
    ySamples[i] = y;
    zSamples[i] = z;

    sumX += x;
    sumY += y;
    sumZ += z;

    sumX2 += x * x;
    sumY2 += y * y;
    sumZ2 += z * z;

    nextSampleTime += samplePeriod;
  }

  // STEP 2: Calculate RMS
  double meanX = sumX / N;
  double meanY = sumY / N;
  double meanZ = sumZ / N;

  double varianceX = sumX2 / N - meanX * meanX;
  double varianceY = sumY2 / N - meanY * meanY;
  double varianceZ = sumZ2 / N - meanZ * meanZ;

  double totalVariance =
    varianceX + varianceY + varianceZ;

  if (totalVariance < 0)
  {
    totalVariance = 0;
  }

  double vibrationRMS = sqrt(totalVariance);

  // STEP 3: Calculate FFT band power
  double peakFrequencyX = 0;

  double powerX =
    calculateBandPower(xSamples, &peakFrequencyX);

  double powerY = calculateBandPower(ySamples);
  double powerZ = calculateBandPower(zSamples);

  double totalBandPower = powerX + powerY + powerZ;

  // =============================
  // STEP 4: TIMER-BASED DETECTION
  // =============================

  unsigned long currentTime = millis();

  bool requestOn =
    !flowDetected &&
    totalBandPower > FLOW_ON_THRESHOLD;

  bool requestOff =
    flowDetected &&
    totalBandPower < FLOW_OFF_THRESHOLD;

  if (requestOn || requestOff)
  {
    if (!transitionPending)
    {
      transitionStart = currentTime;
      transitionPending = true;
    }

    unsigned long requiredDelay =
      requestOn ? FLOW_ON_DELAY : FLOW_OFF_DELAY;

    if (currentTime - transitionStart >= requiredDelay)
    {
      // Save the duration of the previous state
      if (flowDetected)
      {
        lastOnDuration = currentTime - stateStart;
      }
      else
      {
        lastOffDuration = currentTime - stateStart;
      }

      // Switch states
      flowDetected = !flowDetected;

      // Restart current-state timer
      stateStart = currentTime;
      transitionPending = false;
    }
  }
  else
  {
    // Signal returned to normal before timer completed
    transitionPending = false;
  }

  // =============================
  // STEP 5: CALCULATE STATE TIMES
  // =============================

  unsigned long stateDuration =
    currentTime - stateStart;

  double onSeconds =
    flowDetected ? stateDuration / 1000.0 : 0.0;

  double offSeconds =
    !flowDetected ? stateDuration / 1000.0 : 0.0;

  // =============================
  // STEP 6: PRINT RESULTS
  // =============================

  Serial.print("RMS: ");
  Serial.print(vibrationRMS, 6);
  Serial.print(" g");

  Serial.print(" | Band Power: ");
  Serial.print(totalBandPower, 9);
  Serial.print(" g^2");

  Serial.print(" | Peak X: ");
  Serial.print(peakFrequencyX, 2);
  Serial.print(" Hz");

  Serial.print(" | Flow: ");
  Serial.print(flowDetected ? "FLOW" : "NO_FLOW");

  Serial.print(" | ON Time: ");
  Serial.print(onSeconds, 1);
  Serial.print(" s");

  Serial.print(" | OFF Time: ");
  Serial.print(offSeconds, 1);
  Serial.print(" s");

  Serial.print(" | Previous ON: ");
  Serial.print(lastOnDuration / 1000.0, 1);
  Serial.print(" s");

  Serial.print(" | Previous OFF: ");
  Serial.print(lastOffDuration / 1000.0, 1);
  Serial.println(" s");
}
