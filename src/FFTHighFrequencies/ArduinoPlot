
#include <SPI.h>
#include <arduinoFFT.h>
#include <math.h>

// ==================================
// SAMPLING SETTINGS
// ==================================

const uint16_t N = 256;
const double Fs = 8000.0;
const uint32_t samplePeriod = 125; // microseconds

// Frequencies to investigate
const double BAND_LOW = 800.0;
const double BAND_HIGH = 2400.0;

// Hamming window mean-square value for N = 256
const double WINDOW_POWER = 0.395873;

// Example thresholds in g RMS
// Calibrate using your actual pipe!
const double FLOW_ON_THRESHOLD = 0.012;
const double FLOW_OFF_THRESHOLD = 0.008;

// ==================================
// ARRAYS
// ==================================

double vReal[N];
double vImag[N];

float xSamples[N];
float ySamples[N];
float zSamples[N];

// Combined FFT power from three axes
double spectrumPower[N / 2];

ArduinoFFT<double> FFT(vReal, vImag, N, Fs);

// ==================================
// SPI PINS
// ==================================

const int CS_PIN = 33;
const int SCK_PIN = 5;
const int MOSI_PIN = 19;
const int MISO_PIN = 21;

// ==================================
// SENSOR REGISTERS
// ==================================

const byte WHO_AM_I = 0x0F;
const byte CTRL1_XL = 0x10;
const byte CTRL3_C = 0x12;
const byte CTRL8_XL = 0x17;
const byte OUTX_L_A = 0x28;

// Faster SPI for high-frequency acquisition
SPISettings accelSPI(8000000, MSBFIRST, SPI_MODE0);

// ==================================
// WRITE REGISTER
// ==================================

void writeRegister(byte reg, byte value)
{
  SPI.beginTransaction(accelSPI);
  digitalWrite(CS_PIN, LOW);

  SPI.transfer(reg & 0x7F);
  SPI.transfer(value);

  digitalWrite(CS_PIN, HIGH);
  SPI.endTransaction();
}

// ==================================
// READ REGISTER
// ==================================

byte readRegister(byte reg)
{
  SPI.beginTransaction(accelSPI);
  digitalWrite(CS_PIN, LOW);

  SPI.transfer(reg | 0x80);
  byte value = SPI.transfer(0x00);

  digitalWrite(CS_PIN, HIGH);
  SPI.endTransaction();

  return value;
}

// ==================================
// READ ACCELERATION
// ==================================

void readAcceleration(float &x, float &y, float &z)
{
  byte data[6];

  SPI.beginTransaction(accelSPI);
  digitalWrite(CS_PIN, LOW);

  SPI.transfer(OUTX_L_A | 0x80);

  for (int i = 0; i < 6; i++)
  {
    data[i] = SPI.transfer(0x00);
  }

  digitalWrite(CS_PIN, HIGH);
  SPI.endTransaction();

  int16_t rawX = (int16_t)(
    ((uint16_t)data[1] << 8) | data[0]);

  int16_t rawY = (int16_t)(
    ((uint16_t)data[3] << 8) | data[2]);

  int16_t rawZ = (int16_t)(
    ((uint16_t)data[5] << 8) | data[4]);

  // ±2 g sensitivity
  const float sensitivity = 0.000061;

  x = rawX * sensitivity;
  y = rawY * sensitivity;
  z = rawZ * sensitivity;
}

// ==================================
// FFT PROCESSING FOR ONE AXIS
// ==================================

void addAxisSpectrum(const float samples[])
{
  // Copy acceleration into FFT arrays
  for (int i = 0; i < N; i++)
  {
    vReal[i] = samples[i];
    vImag[i] = 0;
  }

  // Remove DC component (gravity/offset)
  FFT.dcRemoval();

  // Apply Hamming window
  FFT.windowing(
    FFTWindow::Hamming,
    FFTDirection::Forward
  );

  // Compute FFT
  FFT.compute(FFTDirection::Forward);

  // Convert complex FFT to magnitude
  FFT.complexToMagnitude();

  // Add squared FFT magnitudes to total
  for (int i = 1; i < N / 2; i++)
  {
    spectrumPower[i] += vReal[i] * vReal[i];
  }
}

// ==================================
// SETUP
// ==================================

void setup()
{
  Serial.begin(115200);
  delay(1000);

  SPI.begin(SCK_PIN, MISO_PIN, MOSI_PIN, CS_PIN);

  pinMode(CS_PIN, OUTPUT);
  digitalWrite(CS_PIN, HIGH);

  delay(100);

  byte id = readRegister(WHO_AM_I);

  Serial.print("WHO_AM_I = 0x");
  Serial.println(id, HEX);

  if (id != 0x7B)
  {
    Serial.println("ERROR: IIS3DWB not detected!");

    while (1)
    {
      delay(1000);
    }
  }

  Serial.println("IIS3DWB detected!");

  // Block Data Update + auto-increment
  writeRegister(CTRL3_C, 0x44);

  // LPF2 cutoff: ODR/10 ≈ 2667 Hz
  writeRegister(CTRL8_XL, 0x20);

  // Enable accelerometer, ±2 g, LPF2
  writeRegister(CTRL1_XL, 0xA2);

  delay(200);

  Serial.println("High-frequency flow detection started");
  Serial.println("Detection band: 800 - 2400 Hz");
}

// ==================================
// MAIN LOOP
// ==================================

void loop()
{
  static bool flowDetected = false;
  static int consecutiveCount = 0;

  uint32_t nextSampleTime = micros();
  int sampleOverruns = 0;

  // --------------------------------
  // STEP 1: Collect 256 XYZ samples
  // --------------------------------

  for (int i = 0; i < N; i++)
  {
    while ((int32_t)(micros() - nextSampleTime) < 0)
    {
      // Wait until next scheduled sample
    }

    float x, y, z;
    readAcceleration(x, y, z);

    xSamples[i] = x;
    ySamples[i] = y;
    zSamples[i] = z;

    nextSampleTime += samplePeriod;

    // Check if acquisition exceeded timing
    if ((int32_t)(micros() - nextSampleTime) >= 0)
    {
      sampleOverruns++;
    }
  }

  if (sampleOverruns > 0)
  {
    Serial.print("WARNING: Sampling overruns = ");
    Serial.println(sampleOverruns);
    return;
  }

  // --------------------------------
  // STEP 2: Clear combined spectrum
  // --------------------------------

  for (int i = 0; i < N / 2; i++)
  {
    spectrumPower[i] = 0;
  }

  // --------------------------------
  // STEP 3: FFT on each axis
  // --------------------------------

  addAxisSpectrum(xSamples);
  addAxisSpectrum(ySamples);
  addAxisSpectrum(zSamples);

  // --------------------------------
  // STEP 4: Find high-frequency power
  // --------------------------------

  double bandPower = 0;
  double peakPower = 0;
  double peakFrequency = 0;

  for (int i = 1; i < N / 2; i++)
  {
    double frequency = i * Fs / N;

    if (frequency >= BAND_LOW &&
        frequency <= BAND_HIGH)
    {
      // Sum power only inside desired band
      bandPower += spectrumPower[i];

      // Find strongest frequency in band
      if (spectrumPower[i] > peakPower)
      {
        peakPower = spectrumPower[i];
        peakFrequency = frequency;
      }
    }
  }

  // --------------------------------
  // STEP 5: Calculate band-limited RMS
  // --------------------------------

  double highFrequencyRMS = sqrt(
    (2.0 * bandPower) /
    (N * N * WINDOW_POWER)
  );

  // --------------------------------
  // STEP 6: Detect water flow
  // --------------------------------

  if (!flowDetected)
  {
    if (highFrequencyRMS > FLOW_ON_THRESHOLD)
    {
      consecutiveCount++;

      if (consecutiveCount >= 3)
      {
        flowDetected = true;
        consecutiveCount = 0;
      }
    }
    else
    {
      consecutiveCount = 0;
    }
  }
  else
  {
    if (highFrequencyRMS < FLOW_OFF_THRESHOLD)
    {
      consecutiveCount++;

      if (consecutiveCount >= 3)
      {
        flowDetected = false;
        consecutiveCount = 0;
      }
    }
    else
    {
      consecutiveCount = 0;
    }
  }


  // STEP 7: Send high-frequency spectrum to Python

  Serial.println("SPECTRUM_START");

  for (int i = 1; i < N / 2; i++)
  {
    double frequency = i * Fs / N;

    if (frequency >= BAND_LOW &&
        frequency <= BAND_HIGH)
    {
      // Combined X, Y, Z FFT magnitude
      double magnitude = sqrt(spectrumPower[i]);

      Serial.print(frequency, 2);
      Serial.print(",");
      Serial.println(magnitude, 6);
    }
  }

  Serial.println("SPECTRUM_END");
}
