#include <SPI.h>

// =============================
// YOUR SCHEMATIC PINS
// =============================

const int CS_PIN   = 33;
const int SCK_PIN  = 5;
const int MOSI_PIN = 19;
const int MISO_PIN = 21;


// =============================
// IIS3DWB REGISTERS 
// =============================

const byte WHO_AM_I = 0x0F; // sensor id
const byte CTRL1_XL = 0x10; //accelerometer settings
const byte CTRL3_C  = 0x12; //general settings

const byte OUTX_L_A = 0x28; // X acceleration


// SPI communication settings
SPISettings accelSPI(1000000, MSBFIRST, SPI_MODE0);


void writeRegister(byte reg, byte value)
{
  SPI.beginTransaction(accelSPI); //Use this setting for the transaction

  digitalWrite(CS_PIN, LOW); //indicate to the accelerometer that we changing something

  // Write command
  SPI.transfer(reg & 0x7F); //this is the registar to edit

  SPI.transfer(value); //send a command or change settings

  digitalWrite(CS_PIN, HIGH); //indicate to accelerometer we done changing

  SPI.endTransaction(); //end the transaction
}

void setup()
{
  Serial.begin(115200);

  delay(1000);

  SPI.begin(SCK_PIN, MISO_PIN, MOSI_PIN, CS_PIN);

  pinMode(CS_PIN, OUTPUT);

  digitalWrite(CS_PIN, HIGH);

  delay(100);


  // -------------------------
  // Check sensor identity
  // -------------------------

  byte id = readRegister(WHO_AM_I);

  Serial.print("WHO_AM_I = 0x");
  Serial.println(id, HEX);


  if (id != 0x7B)
  {
    Serial.println("ERROR: IIS3DWB not detected!");
    while (1)
    {
      delay(1000);
    }
  }

  Serial.println("IIS3DWB detected!");


  // -------------------------
  // Block Data Update +
  // automatic register increment
  // -------------------------

  writeRegister(CTRL3_C, 0x44);


  // -------------------------
  // Enable accelerometer
  // 3 axes
  // ±2 g
  // -------------------------

  writeRegister(CTRL1_XL, 0xA0);

  delay(100);
}

