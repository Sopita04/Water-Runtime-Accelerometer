void setup()
{
  Serial.begin(115200);

  delay(1000);

  SPI.begin(SCK_PIN, MISO_PIN, MOSI_PIN, CS_PIN);

  pinMode(CS_PIN, OUTPUT);

  digitalWrite(CS_PIN, HIGH);

  delay(100);


  // -------------------------
  // Check sensor identity
  // -------------------------

  byte id = readRegister(WHO_AM_I);

  Serial.print("WHO_AM_I = 0x");
  Serial.println(id, HEX);


  if (id != 0x7B)
  {
    Serial.println("ERROR: IIS3DWB not detected!");
    while (1)
    {
      delay(1000);
    }
  }

  Serial.println("IIS3DWB detected!");


  // -------------------------
  // Block Data Update +
  // automatic register increment
  // -------------------------

  writeRegister(CTRL3_C, 0x44);


  // -------------------------
  // Enable accelerometer
  // 3 axes
  // ±2 g
  // -------------------------

  writeRegister(CTRL1_XL, 0xA0);

  delay(100);
}

