
#include <SPI.h>
#include <arduinoFFT.h>
#include <math.h>

// =============================
// SAMPLING SETTINGS
// =============================

const uint16_t N = 256;
const double Fs = 2000.0;
const uint32_t samplePeriod = 500;

// Frequency band
const double BAND_LOW = 150.0;
const double BAND_HIGH = 1000.0;

// Flow thresholds (example only)
const double FLOW_ON_THRESHOLD = 0.010;
const double FLOW_OFF_THRESHOLD = 0.0070;

const int REQUIRED_COUNT = 3;

// =============================
// REFERENCE SENSOR SETTINGS
// =============================

// Enable experimental background correction
const bool USE_REFERENCE_CORRECTION = true;

// Scaling factor for background power
// Must be experimentally validated
const double REF_POWER_SCALE = 1.0;

// =============================
// FFT ARRAYS
// =============================

double vReal[N];
double vImag[N];

ArduinoFFT<double> FFT(vReal, vImag, N, Fs);

// Pipe accelerometer samples
float pipeX[N];
float pipeY[N];
float pipeZ[N];

// Reference accelerometer samples
float refX[N];
float refY[N];
float refZ[N];

// Hamming window correction
double windowPower = 1.0;

// =============================
// ESP32 SPI PINS
// =============================

const int CS_PIPE = 33;
const int CS_REF = 27;

const int SCK_PIN = 5;
const int MOSI_PIN = 19;
const int MISO_PIN = 21;

// =============================
// IIS3DWB REGISTERS
// =============================

const byte WHO_AM_I = 0x0F;
const byte CTRL1_XL = 0x10;
const byte CTRL3_C = 0x12;
const byte CTRL8_XL = 0x17;
const byte OUTX_L_A = 0x28;

SPISettings accelSPI(
  1000000,
  MSBFIRST,
  SPI_MODE0
);

// =============================
// WRITE REGISTER
// =============================

// csPin selects which accelerometer

void writeRegister(
  int csPin,
  byte reg,
  byte value
)
{
  SPI.beginTransaction(accelSPI);

  digitalWrite(csPin, LOW);

  SPI.transfer(reg & 0x7F);
  SPI.transfer(value);

  digitalWrite(csPin, HIGH);

  SPI.endTransaction();
}

// =============================
// READ REGISTER
// =============================

byte readRegister(
  int csPin,
  byte reg
)
{
  SPI.beginTransaction(accelSPI);

  digitalWrite(csPin, LOW);

  SPI.transfer(reg | 0x80);

  byte value = SPI.transfer(0x00);

  digitalWrite(csPin, HIGH);

  SPI.endTransaction();

  return value;
}

// =============================
// READ X, Y, Z ACCELERATION
// =============================

void readAcceleration(
  int csPin,
  float &x,
  float &y,
  float &z
)
{
  byte data[6];

  SPI.beginTransaction(accelSPI);

  digitalWrite(csPin, LOW);

  SPI.transfer(OUTX_L_A | 0x80);

  for (int i = 0; i < 6; i++)
  {
    data[i] = SPI.transfer(0x00);
  }

  digitalWrite(csPin, HIGH);

  SPI.endTransaction();

  int16_t rawX =
    (int16_t)((data[1] << 8) | data[0]);

  int16_t rawY =
    (int16_t)((data[3] << 8) | data[2]);

  int16_t rawZ =
    (int16_t)((data[5] << 8) | data[4]);

  // +/- 2g sensitivity
  const float sensitivity = 0.000061;

  x = rawX * sensitivity;
  y = rawY * sensitivity;
  z = rawZ * sensitivity;
}

// =============================
// CONFIGURE ACCELEROMETER
// =============================

void configureAccelerometer(int csPin)
{
  // Block Data Update and auto increment
  writeRegister(csPin, CTRL3_C, 0x44);

  // LPF2 bandwidth approximately 1333 Hz
  writeRegister(csPin, CTRL8_XL, 0x40);

  // Enable three axes, +/- 2g, LPF2
  writeRegister(csPin, CTRL1_XL, 0xA2);
}

// =============================
// CALCULATE FFT BAND POWER
// =============================

double calculateBandPower(
  const float samples[],
  double &peakMagnitude,
  double &peakFrequency
)
{
  // STEP 1: Load samples
  for (int i = 0; i < N; i++)
  {
    vReal[i] = samples[i];
    vImag[i] = 0;
  }

  // STEP 2: Remove DC
  FFT.dcRemoval();

  // STEP 3: Hamming window
  FFT.windowing(
    FFTWindow::Hamming,
    FFTDirection::Forward
  );

  // STEP 4: FFT
  FFT.compute(FFTDirection::Forward);

  FFT.complexToMagnitude();

  // STEP 5: Sum band power
  double bandPowerSum = 0;

  for (int i = 1; i <= N / 2; i++)
  {
    double frequency = i * Fs / N;

    if (frequency < BAND_LOW ||
        frequency > BAND_HIGH)
    {
      continue;
    }

    double magnitude = vReal[i];

    if (magnitude > peakMagnitude)
    {
      peakMagnitude = magnitude;
      peakFrequency = frequency;
    }

    double power = magnitude * magnitude;

    if (i < N / 2)
    {
      power *= 2.0;
    }

    bandPowerSum += power;
  }

  // STEP 6: Normalize FFT power
  double meanSquare =
    bandPowerSum / (N * N * windowPower);

  return meanSquare;
}

// =============================
// CALCULATE THREE-AXIS POWER
// =============================

double calculateTotalPower(
  const float xSamples[],
  const float ySamples[],
  const float zSamples[],
  double &peakFrequency
)
{
  double peakMagnitude = 0;
  peakFrequency = 0;

  double powerX = calculateBandPower(
    xSamples,
    peakMagnitude,
    peakFrequency
  );

  double powerY = calculateBandPower(
    ySamples,
    peakMagnitude,
    peakFrequency
  );

  double powerZ = calculateBandPower(
    zSamples,
    peakMagnitude,
    peakFrequency
  );

  return powerX + powerY + powerZ;
}

// =============================
// SETUP
// =============================

void setup()
{
  Serial.begin(115200);

  Serial1.begin(
    115200,
    SERIAL_8N1,
    7,
    8
  );

  delay(1000);

  // Configure separate chip selects
  pinMode(CS_PIPE, OUTPUT);
  pinMode(CS_REF, OUTPUT);

  digitalWrite(CS_PIPE, HIGH);
  digitalWrite(CS_REF, HIGH);

  SPI.begin(
    SCK_PIN,
    MISO_PIN,
    MOSI_PIN,
    CS_PIPE
  );

  delay(100);

  // Check pipe sensor
  byte idPipe = readRegister(
    CS_PIPE,
    WHO_AM_I
  );

  // Check reference sensor
  byte idRef = readRegister(
    CS_REF,
    WHO_AM_I
  );

  Serial.print("Pipe WHO_AM_I: 0x");
  Serial.println(idPipe, HEX);

  Serial.print("Reference WHO_AM_I: 0x");
  Serial.println(idRef, HEX);

  if (idPipe != 0x7B || idRef != 0x7B)
  {
    Serial.println(
      "ERROR: One or both sensors not detected!"
    );

    while (1)
    {
      delay(1000);
    }
  }

  Serial.println("Both IIS3DWB sensors detected!");

  // Configure each accelerometer
  configureAccelerometer(CS_PIPE);
  configureAccelerometer(CS_REF);

  // Hamming window power correction
  double windowSumSquares = 0;

  for (int i = 0; i < N; i++)
  {
    double w = 0.54 -
      0.46 * cos(2.0 * PI * i / (N - 1));

    windowSumSquares += w * w;
  }

  windowPower = windowSumSquares / N;

  delay(200);

  Serial.println("Dual accelerometer system ready!");
}

// =============================
// MAIN LOOP
// =============================

void loop()
{
  static bool flowDetected = false;
  static int consecutiveCount = 0;

  // =============================
  // STEP 1: COLLECT BOTH SENSORS
  // =============================

  uint32_t nextSampleTime = micros();

  for (int i = 0; i < N; i++)
  {
    while (
      (int32_t)(micros() - nextSampleTime) < 0
    )
    {
    }

    // Pipe accelerometer
    readAcceleration(
      CS_PIPE,
      pipeX[i],
      pipeY[i],
      pipeZ[i]
    );

    // Reference accelerometer
    readAcceleration(
      CS_REF,
      refX[i],
      refY[i],
      refZ[i]
    );

    nextSampleTime += samplePeriod;
  }

  // =============================
  // STEP 2: CALCULATE PIPE POWER
  // =============================

  double pipePeakFrequency = 0;

  double pipePower = calculateTotalPower(
    pipeX,
    pipeY,
    pipeZ,
    pipePeakFrequency
  );

  // =============================
  // STEP 3: CALCULATE REF POWER
  // =============================

  double refPeakFrequency = 0;

  double refPower = calculateTotalPower(
    refX,
    refY,
    refZ,
    refPeakFrequency
  );

  // =============================
  // STEP 4: COMPARE VIBRATION
  // =============================

  double pipeRMS = sqrt(pipePower);
  double refRMS = sqrt(refPower);

  // Experimental background correction
  double excessPower =
    pipePower - REF_POWER_SCALE * refPower;

  // Avoid negative power
  if (excessPower < 0)
  {
    excessPower = 0;
  }

  double excessRMS = sqrt(excessPower);

  // Choose which signal controls detection
  double detectionRMS =
    USE_REFERENCE_CORRECTION ?
    excessRMS : pipeRMS;

  // =============================
  // STEP 5: FLOW DETECTION
  // =============================

  if (!flowDetected)
  {
    if (detectionRMS > FLOW_ON_THRESHOLD)
    {
      consecutiveCount++;

      if (consecutiveCount >= REQUIRED_COUNT)
      {
        flowDetected = true;
        consecutiveCount = 0;
      }
    }
    else
    {
      consecutiveCount = 0;
    }
  }
  else
  {
    if (detectionRMS < FLOW_OFF_THRESHOLD)
    {
      consecutiveCount++;

      if (consecutiveCount >= REQUIRED_COUNT)
      {
        flowDetected = false;
        consecutiveCount = 0;
      }
    }
    else
    {
      consecutiveCount = 0;
    }
  }

  // =============================
  // STEP 6: PRINT RESULTS
  // =============================

  Serial.print("Pipe RMS: ");
  Serial.print(pipeRMS, 6);
  Serial.print(" g");

  Serial.print(" | Ref RMS: ");
  Serial.print(refRMS, 6);
  Serial.print(" g");

  Serial.print(" | Excess RMS: ");
  Serial.print(excessRMS, 6);
  Serial.print(" g");

  Serial.print(" | Peak: ");
  Serial.print(pipePeakFrequency, 2);
  Serial.print(" Hz");

  Serial.print(" | Flow Status: ");

  if (flowDetected)
  {
    Serial.println("FLOW");
    Serial1.print("FLOW\n");
  }
  else
  {
    Serial.println("NO_FLOW");
    Serial1.print("NO_FLOW\n");
  }
}
