#include <SPI.h>
#include <arduinoFFT.h>
#include <math.h>

// =============================
// SAMPLING SETTINGS
// =============================

const uint16_t N = 256;
const double Fs = 2000.0;
const uint32_t samplePeriod = 500;

// Frequency band for flow detection
const double BAND_LOW = 150.0;
const double BAND_HIGH = 1000.0;

// EXAMPLE THRESHOLDS - CALIBRATE THESE!
// Units: g RMS
const double FLOW_ON_THRESHOLD = 0.0030;
const double FLOW_OFF_THRESHOLD = 0.0020;

const int REQUIRED_COUNT = 3;

// =============================
// FFT ARRAYS
// =============================

double vReal[N];
double vImag[N];

ArduinoFFT<double> FFT(vReal, vImag, N, Fs);

// Store all three acceleration axes
float xSamples[N];
float ySamples[N];
float zSamples[N];

// Hamming window power correction
double windowPower = 1.0;

// =============================
// ESP32 SPI PINS
// =============================

const int CS_PIN = 33;
const int SCK_PIN = 5;
const int MOSI_PIN = 19;
const int MISO_PIN = 21;

// =============================
// IIS3DWB REGISTERS
// =============================

const byte WHO_AM_I = 0x0F;
const byte CTRL1_XL = 0x10;
const byte CTRL3_C = 0x12;
const byte CTRL8_XL = 0x17;
const byte OUTX_L_A = 0x28;

SPISettings accelSPI(1000000, MSBFIRST, SPI_MODE0);

// =============================
// WRITE REGISTER
// =============================

void writeRegister(byte reg, byte value)
{
  SPI.beginTransaction(accelSPI);

  digitalWrite(CS_PIN, LOW);

  SPI.transfer(reg & 0x7F);
  SPI.transfer(value);

  digitalWrite(CS_PIN, HIGH);

  SPI.endTransaction();
}

// =============================
// READ REGISTER
// =============================

byte readRegister(byte reg)
{
  SPI.beginTransaction(accelSPI);

  digitalWrite(CS_PIN, LOW);

  SPI.transfer(reg | 0x80);

  byte value = SPI.transfer(0x00);

  digitalWrite(CS_PIN, HIGH);

  SPI.endTransaction();

  return value;
}

// =============================
// READ X, Y, Z ACCELERATION
// =============================

void readAcceleration(float &x, float &y, float &z)
{
  byte data[6];

  SPI.beginTransaction(accelSPI);

  digitalWrite(CS_PIN, LOW);

  SPI.transfer(OUTX_L_A | 0x80);

  for (int i = 0; i < 6; i++)
  {
    data[i] = SPI.transfer(0x00);
  }

  digitalWrite(CS_PIN, HIGH);

  SPI.endTransaction();

  int16_t rawX = (int16_t)((data[1] << 8) | data[0]);
  int16_t rawY = (int16_t)((data[3] << 8) | data[2]);
  int16_t rawZ = (int16_t)((data[5] << 8) | data[4]);

  // +/- 2g sensitivity
  const float sensitivity = 0.000061;

  x = rawX * sensitivity;
  y = rawY * sensitivity;
  z = rawZ * sensitivity;
}

// =============================
// CALCULATE HIGH-FREQUENCY POWER
// =============================

// Returns mean-square acceleration (g^2)
// between BAND_LOW and BAND_HIGH.
//
// Also finds the strongest frequency
// inside the selected frequency band.

double calculateBandPower(
  const float samples[],
  double &peakMagnitude,
  double &peakFrequency
)
{
  // STEP 1: Load samples into FFT arrays
  for (int i = 0; i < N; i++)
  {
    vReal[i] = samples[i];
    vImag[i] = 0;
  }

  // STEP 2: Remove DC component
  FFT.dcRemoval();

  // STEP 3: Apply Hamming window
  FFT.windowing(
    FFTWindow::Hamming,
    FFTDirection::Forward
  );

  // STEP 4: Perform FFT
  FFT.compute(FFTDirection::Forward);

  FFT.complexToMagnitude();

  // STEP 5: Sum frequency-band power
  double bandPowerSum = 0;

  for (int i = 1; i <= N / 2; i++)
  {
    double frequency = i * Fs / N;

    // Ignore frequencies outside our band
    if (frequency < BAND_LOW ||
        frequency > BAND_HIGH)
    {
      continue;
    }

    double magnitude = vReal[i];

    // Track strongest frequency in band
    if (magnitude > peakMagnitude)
    {
      peakMagnitude = magnitude;
      peakFrequency = frequency;
    }

    // Convert FFT magnitude to power
    double power = magnitude * magnitude;

    // Account for negative-frequency energy
    // Nyquist bin must NOT be doubled
    if (i < N / 2)
    {
      power *= 2.0;
    }

    bandPowerSum += power;
  }

  // STEP 6: Normalize FFT power
  // and compensate for Hamming window
  double meanSquare =
    bandPowerSum / (N * N * windowPower);

  return meanSquare;
}

// =============================
// SETUP
// =============================

void setup()
{
  Serial.begin(115200);

  delay(1000);

  SPI.begin(SCK_PIN, MISO_PIN, MOSI_PIN, CS_PIN);

  pinMode(CS_PIN, OUTPUT);
  digitalWrite(CS_PIN, HIGH);

  delay(100);

  // Check sensor identity
  byte id = readRegister(WHO_AM_I);

  Serial.print("WHO_AM_I = 0x");
  Serial.println(id, HEX);

  if (id != 0x7B)
  {
    Serial.println("ERROR: IIS3DWB not detected!");

    while (1)
    {
      delay(1000);
    }
  }

  Serial.println("IIS3DWB detected!");

  // Block Data Update + register increment
  writeRegister(CTRL3_C, 0x44);

  // Configure LPF2 bandwidth:
  // ODR / 20 = approximately 1333 Hz
  writeRegister(CTRL8_XL, 0x40);

  // Enable 3 axes, +/- 2g, LPF2
  writeRegister(CTRL1_XL, 0xA2);

  // Calculate Hamming window power correction
  double windowSumSquares = 0;

  for (int i = 0; i < N; i++)
  {
    double w = 0.54 -
      0.46 * cos(2.0 * PI * i / (N - 1));

    windowSumSquares += w * w;
  }

  windowPower = windowSumSquares / N;

  delay(200);

  Serial.println("High-frequency flow detection ready!");
  Serial.println("Detection band: 150-1000 Hz");
}

// =============================
// MAIN LOOP
// =============================

void loop()
{
  static bool flowDetected = false;
  static int consecutiveCount = 0;

  // STEP 1: Collect 256 samples
  uint32_t nextSampleTime = micros();

  for (int i = 0; i < N; i++)
  {
    while ((int32_t)(micros() - nextSampleTime) < 0)
    {
    }

    float x, y, z;

    readAcceleration(x, y, z);

    xSamples[i] = x;
    ySamples[i] = y;
    zSamples[i] = z;

    nextSampleTime += samplePeriod;
  }

  // STEP 2: Calculate FFT band power
  // separately for X, Y, and Z

  double peakMagnitude = 0;
  double peakFrequency = 0;

  double powerX = calculateBandPower(
    xSamples, peakMagnitude, peakFrequency
  );

  double powerY = calculateBandPower(
    ySamples, peakMagnitude, peakFrequency
  );

  double powerZ = calculateBandPower(
    zSamples, peakMagnitude, peakFrequency
  );

  // STEP 3: Combine three-axis power
  double totalBandPower =
    powerX + powerY + powerZ;

  // Convert power (g^2) to RMS (g)
  double bandRMS = sqrt(totalBandPower);

  // STEP 4: Detect flow using hysteresis

  if (!flowDetected)
  {
    // Currently NO_FLOW
    // Switch ON when RMS exceeds threshold

    if (bandRMS > FLOW_ON_THRESHOLD)
    {
      consecutiveCount++;

      if (consecutiveCount >= REQUIRED_COUNT)
      {
        flowDetected = true;
        consecutiveCount = 0;
      }
    }
    else
    {
      consecutiveCount = 0;
    }
  }
  else
  {
    // Currently FLOW
    // Switch OFF when RMS falls below threshold

    if (bandRMS < FLOW_OFF_THRESHOLD)
    {
      consecutiveCount++;

      if (consecutiveCount >= REQUIRED_COUNT)
      {
        flowDetected = false;
        consecutiveCount = 0;
      }
    }
    else
    {
      consecutiveCount = 0;
    }
  }

  // STEP 5: Print results

  Serial.print("Band RMS: ");
  Serial.print(bandRMS, 6);
  Serial.print(" g");

  Serial.print(" | Peak in Band: ");
  Serial.print(peakFrequency, 2);
  Serial.print(" Hz");

  Serial.print(" | Flow Status: ");

  if (flowDetected)
  {
    Serial.println("FLOW");
  }
  else
  {
    Serial.println("NO_FLOW");
  }
}
